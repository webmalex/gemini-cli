- Use userHomePath as fallback when currentWorkingDirectory is empty string
- Prevents loading context from incorrect location when user is in home dir
- Addresses review feedback about potential bug in currentDirectoryOnly mode
---
 packages/core/src/utils/memoryDiscovery.ts | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/packages/core/src/utils/memoryDiscovery.ts b/packages/core/src/utils/memoryDiscovery.ts
index 7406fa88cfd..23e9d3d17c4 100644
--- a/packages/core/src/utils/memoryDiscovery.ts
+++ b/packages/core/src/utils/memoryDiscovery.ts
@@ -92,7 +92,7 @@ async function getGeminiMdFilePathsInternal(
 ): Promise<string[]> {
   const dirs = new Set<string>(
     currentDirectoryOnly
-      ? [currentWorkingDirectory]
+      ? [currentWorkingDirectory || userHomePath]
       : [...includeDirectoriesToReadGemini, currentWorkingDirectory],
   );
 

